rules_version = '2';

// Negar tudo (ADR-035). O Firestore só é acessado pela API, com a conta de serviço do Cloud Run, que
// ignora estas regras. Nenhum cliente (app web, celular) fala direto com o banco; por isso nenhuma
// regra libera leitura ou escrita. Para aplicar: Firestore > Regras > colar este arquivo > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
