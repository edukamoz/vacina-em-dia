flowchart LR
    DEV["Desenvolvedor<br/>branch + pull request"] --> GH["GitHub"]
    GH --> CI["GitHub Actions: CI<br/>lint, tipos, build, testes e cobertura,<br/>npm audit, pip-audit, Docker"]
    GH -- "merge na main" --> DEP["GitHub Actions: Deploy<br/>Workload Identity Federation (sem chave)"]
    DEP --> CB["Cloud Build<br/>imagens da API, do PLN e do web"]
    CB --> AR["Artifact Registry"]
    DEP --> RUN["gcloud run services update<br/>troca a imagem de cada serviço"]
    AR --> RUN
    RUN --> RAPI["Cloud Run: vacina-api"]
    RUN --> RNLP["Cloud Run: vacina-nlp"]
    RUN --> RWEB["Cloud Run: vacina-web"]
    RAPI --> FS[("Firestore")]
    RAPI --> RNLP
    RAPI --> SP["Cloud Speech-to-Text"]
    DEP --> FUM["Teste de fumaça<br/>API, PLN e web"]
    LOCAL["Local: docker compose up<br/>API, PLN e web"] -. "mesma base de código" .-> DEV
