{
  "expo": {
    "name": "Vacina em Dia",
    "slug": "vacina-em-dia",
    "version": "0.1.0",
    "scheme": "vacinaemdia",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Vacina em Dia usa a sua localização só para mostrar os postos de saúde perto de você. A posição não é guardada."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Vacina em Dia usa o microfone só para ouvir a sua pergunta por voz. O áudio não é guardado."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#0B6B52",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      }
    }
  }
}
