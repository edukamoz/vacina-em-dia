{
  "expo": {
    "name": "Vacina em Dia",
    "slug": "vacina-em-dia",
    "version": "0.1.0",
    "scheme": "vacinaemdia",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "O Vacina em Dia usa o microfone só para ouvir a sua pergunta por voz. O áudio não é guardado."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
