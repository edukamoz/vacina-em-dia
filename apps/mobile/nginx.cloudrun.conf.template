# Versão do nginx para o Cloud Run (plano de contingência no Google Cloud, ADR-035). O contêiner
# `nginx` troca as variáveis ${...} ao subir: PORT (o Cloud Run define), API_URL (endereço do serviço
# da API, sem barra no fim), API_HOST (só o nome do host dele) e DNS_RESOLVER (padrão 8.8.8.8).
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "microphone=(self), camera=(), geolocation=(self)" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # A API fica atrás do mesmo endereço do app (sem CORS). O endereço do Cloud Run muda de IP, então
  # o nome é resolvido a cada uso (por isso a variável e o `resolver`).
  resolver ${DNS_RESOLVER} ipv6=off valid=30s;
  location /api/ {
    set $api_upstream ${API_URL};
    proxy_pass $api_upstream;
    proxy_ssl_server_name on;
    proxy_set_header Host ${API_HOST};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  location /_expo/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
